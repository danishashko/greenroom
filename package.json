{
  "name": "greenroom-cli",
  "version": "0.1.1",
  "description": "Rehearse a launch, pricing change or repositioning against simulated buyers built from real conversations.",
  "author": "Daniel Shashko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danishashko/greenroom.git"
  },
  "homepage": "https://github.com/danishashko/greenroom#readme",
  "bugs": {
    "url": "https://github.com/danishashko/greenroom/issues"
  },
  "type": "module",
  "bin": {
    "greenroom": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "smoke:mcp": "node scripts/mcp-smoke.mjs"
  },
  "keywords": [
    "gtm",
    "simulation",
    "multi-agent",
    "mcp",
    "brightdata",
    "pricing",
    "launch",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
